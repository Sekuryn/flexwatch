[Unit]
Description=Synchronise le secret Telegram depuis AWS Secrets Manager vers k3s
Documentation=https://github.com/Sekuryn/flexwatch/blob/main/PLAN.md
After=k3s.service network-online.target
Wants=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/flexwatch-secret-sync.sh

# Durcissement systemd : le script a besoin du réseau, de kubectl et de rien
# d'autre. Ces directives limitent ce qu'un script compromis pourrait faire.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Seuls chemins accessibles en écriture.
ReadWritePaths=/var/lib/flexwatch
ReadOnlyPaths=/etc/rancher/k3s

[Install]
WantedBy=multi-user.target
