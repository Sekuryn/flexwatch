[Unit]
Description=Resynchronise le secret Telegram toutes les heures
Documentation=https://github.com/Sekuryn/flexwatch/blob/main/PLAN.md

[Timer]
# Au démarrage (le pod doit trouver son secret), puis toutes les heures pour
# récupérer une rotation faite dans Secrets Manager.
OnBootSec=2min
OnUnitActiveSec=1h
# Décale l'exécution de 0 à 5 min : évite de taper l'API AWS pile à l'heure
# ronde, comme tout le monde.
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
